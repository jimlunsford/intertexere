<?xml version="1.0"?>
<phpunit
    bootstrap="tests/bootstrap.php"
    colors="true"
    failOnRisky="true"
    failOnWarning="true"
>
    <testsuites>
        <testsuite name="Intertexere">
            <directory suffix=".php">tests</directory>
            <exclude>tests/e2e</exclude>
        </testsuite>
    </testsuites>
</phpunit>

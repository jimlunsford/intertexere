{
  "name": "jimlunsford/intertexere",
  "description": "Contextual internal linking assistant for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "scripts": {
    "test": "phpunit",
    "test:syntax": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
  }
}
